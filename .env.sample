# =============================================================================
# Schneider Field Service Technician Copilot — environment configuration
# =============================================================================
# HOW TO USE:
#   1. Copy this file to ".env" in this same folder:
#        Windows :  copy .env.sample .env
#        mac/Linux: cp .env.sample .env
#   2. Replace every <PLACEHOLDER> below with your real value (see hints).
#   3. Sign in once with:  az login   (auth is Entra ID / keyless — no API keys).
#
# The labs auto-discover this file by walking up from the notebook folder, so
# keeping ".env" here in "schneider-technician-copilot/" is all you need.
# Values shown are EXAMPLES — do not commit your real .env (it is gitignored).
# =============================================================================

# --- 🤖 Foundry project (REQUIRED — all labs) --------------------------------
# Foundry portal -> your project -> Overview -> Endpoints -> "Project endpoint".
# Format: https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
AI_FOUNDRY_PROJECT_ENDPOINT=https://schneider-foundry.services.ai.azure.com/api/projects/technician-copilot

# --- 🔗 Azure OpenAI endpoint (REQUIRED — Lab 04/05/06 embeddings) ------------
# Same Foundry resource, OpenAI surface. Used by config.embed_texts (REST call).
# Format: https://<foundry-resource>.openai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=https://schneider-foundry.openai.azure.com/openai/v1

# --- 🧠 Model deployment names (REQUIRED) ------------------------------------
# These must EXACTLY match the deployment names you created in the Foundry
# portal (Models + endpoints). Change them if you deployed different models.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4
EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-large

# --- 🔍 Azure AI Search (OPTIONAL — Labs 04/05/06) ---------------------------
# The labs read the Search connection from the project's DEFAULT AI Search
# connection (configured in the Foundry portal), so these are informational /
# optional. Set the endpoint if you want it available to scripts.
# Format: https://<search-service>.search.windows.net
AZURE_AI_SEARCH_ENDPOINT=https://schneider-workshop-search.search.windows.net
# Leave BLANK to use az login + RBAC (recommended). Only set a key if your
# Search service uses key auth.
AZURE_AI_SEARCH_API_KEY=

# --- 📊 Observability (OPTIONAL — Lab 06) ------------------------------------
# Lab 06 auto-discovers Application Insights from the project. Only set this as
# a fallback if discovery fails: App Insights -> Overview -> Connection String.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Record full prompt/response content in traces (DEV/TEST ONLY). Lab 06 sets
# this in code too; leaving it here makes the intent explicit.
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=true

# --- 📄 Content Understanding (OPTIONAL — Lab 07) ----------------------------
# Lab 07 extracts structured data from complex PDFs before AI Search ingestion.
# Content Understanding is exposed on your Foundry / Azure AI Services resource
# at its "services.ai.azure.com" base URL. If you leave this blank, Lab 07
# derives it from AI_FOUNDRY_PROJECT_ENDPOINT (strips the /api/projects/... part).
# Format: https://<resource>.services.ai.azure.com/
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://schneider-foundry.services.ai.azure.com/
# Deployment names CU maps for the prebuilt-documentSearch analyzer. These must
# exist on the resource. Requires the "Cognitive Services User" role (keyless).
CU_GPT_MINI_DEPLOYMENT=gpt-4.1-mini
CU_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# --- 🛡️ Guardrails (OPTIONAL — Lab 08) ---------------------------------------
# Lab 08 stacks Content Safety guardrails (Prompt Shields + PII + a custom
# Schneider blocklist) on a dedicated model deployment. It talks to the RAI
# surface over ARM REST and needs your SUBSCRIPTION id. If you leave this blank,
# the lab derives it from `az account show`. The lab also derives the Content
# Safety account + resource group from AI_FOUNDRY_PROJECT_ENDPOINT via the Azure
# CLI, so no other new value is required.
# Requires the "Cognitive Services Contributor" role on the resource (keyless).
# Azure portal -> Subscriptions -> your subscription -> Subscription ID.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# The base model Lab 08 wraps with a guardrails policy is CU_GPT_MINI_DEPLOYMENT
# (set in the Content Understanding section above — reused so the gpt-5.4 prod
# deployment stays untouched). The lab creates a NEW "<that>-guardrails"
# deployment from it.

# --- 🔴 Red teaming (OPTIONAL — Lab 09) --------------------------------------
# Lab 09 runs the AI Red Teaming Agent against the copilot. It logs results to
# AI_FOUNDRY_PROJECT_ENDPOINT (above) and needs no extra config, BUT the project
# must be in a supported region (e.g. East US 2, Sweden Central, France Central,
# Switzerland West) and the kernel must be Python 3.10-3.13 (PyRIT requirement).

# --- 🔐 Tenant (OPTIONAL) ----------------------------------------------------
# Only needed if your account spans multiple Entra tenants and `az login`
# defaults to the wrong one. Azure portal -> Microsoft Entra ID -> Tenant ID.
TENANT_ID=00000000-0000-0000-0000-000000000000
