# Normalize text files to LF in the repo
* text=auto eol=lf

# Treat these as binary (no line-ending conversion, no diff)
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary

# Jupyter notebooks are JSON — keep LF, don't try to merge line-endings
*.ipynb text eol=lf
